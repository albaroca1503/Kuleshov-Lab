# TMDB API Key (obtener en https://www.themoviedb.org/settings/api)
TMDB_API_KEY=your_tmdb_api_key_here

# AI API Key (optional — enables re-ranking, Signal write-ups, and taste profiles)
# Provider-agnostic: works with any model litellm supports (Anthropic, OpenAI, Gemini, Ollama, etc.)
# Set AI_MODEL_FAST / AI_MODEL_SMART below to match the provider this key belongs to.
AI_API_KEY=your_ai_api_key_here

# AI models (any litellm-compatible model string)
# Examples: "claude-sonnet-4-6" · "gpt-4o" · "gemini/gemini-2.0-flash" · "ollama/llama3"
AI_MODEL_FAST=claude-haiku-4-5-20251001
AI_MODEL_SMART=claude-sonnet-4-6

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/kuleshov.db

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# CORS (frontend URL)
FRONTEND_URL=http://localhost:3000